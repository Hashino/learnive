# learnive local config (template). Copy to `.env` and fill in.
# The real `.env` is gitignored — never commit your keys (§12).

# --- Option A: any OpenAI-compatible provider (generic BYOK) ------------------
# base_url is the part before `/chat/completions`. Set both models explicitly.
# Example — Inception Labs' Mercury:
#LEARNIVE_API_BASE_URL=https://api.inceptionlabs.ai/v1
#LEARNIVE_API_KEY=sk_...
#LEARNIVE_MODEL_FAST=mercury-2
#LEARNIVE_MODEL_ROBUST=mercury-2

# --- Option B: OpenRouter (default path, §12) --------------------------------
# Without any provider configured here or in the in-app settings window, the
# app opens Settings and generates nothing (§22) — it never falls back to
# demo content for a real user.
# Get a key at https://openrouter.ai/keys
LEARNIVE_OPENROUTER_KEY=sk-or-v1-...

# Model tiering by intent (§12.1). Optional: if absent, uses the app defaults.
# Light model (exercises, grading, summaries) and robust (prose, confrontation).
# Example — a free, zero-cost pair:
#LEARNIVE_MODEL_FAST=openai/gpt-oss-120b:free
#LEARNIVE_MODEL_ROBUST=openai/gpt-oss-120b:free

# --- Misc (optional) ---------------------------------------------------------
#LEARNIVE_PORT=7420
#LEARNIVE_DATA_DIR=learnive-data
#LEARNIVE_NO_OPEN=1   # skip auto-opening the browser on startup

# Source acquisition mirrors (comma-separated candidate roots, first to answer
# wins) — read by `build_source`/`build_fallback_source` (`api/cold_start.rs`).
# Architecturally obsolete under the local-file-library decision (§11.1) but
# deliberately kept in the tree by user instruction (PLAN.md S28 item 5); set
# these only if you understand what LibGen/Sci-Hub are and want that path.
#LEARNIVE_LIBGEN_URL=https://libgen.li,https://libgen.im,https://libgen.is,https://libgen.rs,https://libgen.st
#LEARNIVE_SCIHUB_URL=https://sci-hub.ee,https://sci-hub.se,https://sci-hub.st,https://sci-hub.wf,https://sci-hub.ren

# Dev/test escape hatch: force offline demo mode regardless of any provider
# configured above or in the settings window. Not a normal way to run the app.
#LEARNIVE_DEMO=1
