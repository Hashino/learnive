# Configuração local do learnive (molde). Copie para `.env` e preencha.
# O `.env` real é gitignorado — nunca versione suas chaves (§12).

# Chave do OpenRouter (caminho padrão do §12). Sem ela, o app roda em MODO DEMO
# (mock offline, sem custo). Obtenha em https://openrouter.ai/keys
LEARNIVE_OPENROUTER_KEY=sk-or-v1-...

# Tiering por intenção (§12.1). Opcional: se ausente, usa os padrões do app.
# Modelo leve (exercícios, correção, resumos) e robusto (prosa, confronto).
# Ex.: um par gratuito, custo zero:
#LEARNIVE_MODEL_FAST=openai/gpt-oss-120b:free
#LEARNIVE_MODEL_ROBUST=openai/gpt-oss-120b:free

# Porta e diretório de dados (opcionais).
#LEARNIVE_PORT=7420
#LEARNIVE_DATA_DIR=learnive-data
